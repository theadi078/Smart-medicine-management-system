# Flask secret key - used to sign session cookies. Change this to a random string.
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database URL. Defaults to a local SQLite file if not set.
DATABASE_URL=sqlite:///database/smart_medicine.db

# OPTIONAL: External AI API key (e.g. Anthropic). The app works fully
# without this using the built-in rule/intent-based assistant fallback.
AI_API_KEY=

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True

# Default reminder window in minutes - how long after a scheduled time
# a dose is still considered "on time" before being marked Missed.
DEFAULT_REMINDER_WINDOW=60

# Max upload size in MB for prescription files
MAX_UPLOAD_MB=5
